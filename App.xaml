<Application x:Class="HeroTweaker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBgBrush" Color="#0B0F11" />
            <SolidColorBrush x:Key="SidebarBgBrush" Color="#0E1315" />
            <SolidColorBrush x:Key="CardBgBrush" Color="#131A1D" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#1B2528" />
            <SolidColorBrush x:Key="BorderBrush" Color="#2C393C" />
            <SolidColorBrush x:Key="CyanAccentBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="CyanGlowBrush" Color="#0284C7" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAF0EE" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A7B4B1" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#70807C" />

            <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5038BDF8" Offset="0.0" />
                <GradientStop Color="#1F2C393C" Offset="0.5" />
                <GradientStop Color="#503A5050" Offset="1.0" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
