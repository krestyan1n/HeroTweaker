<UserControl x:Class="HeroTweaker.Controls.DiskDonutChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400" Height="400">
    <Grid>
        <!-- Холст для отрисовки дуг Sunburst -->
        <Canvas x:Name="ChartCanvas" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Центральный инфо-блок -->
        <Border Width="164" Height="164" CornerRadius="82" 
                Background="#0F0F16" BorderBrush="#252538" BorderThickness="2"
                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                <TextBlock x:Name="CenterBadgeText" Text="📁 КАТАЛОГ" 
                           Foreground="#818CF8" FontSize="10" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock x:Name="CenterTitleText" Text="Загрузка..." 
                           Foreground="#FAFAFA" FontSize="12" FontWeight="SemiBold" 
                           HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="136"/>
                <TextBlock x:Name="CenterSizeText" Text="0 ГБ" 
                           Foreground="#FFFFFF" FontSize="19" FontWeight="Black" 
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock x:Name="CenterSubText" Text="Sunburst 2-Layer" 
                           Foreground="#71717A" FontSize="10" 
                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>