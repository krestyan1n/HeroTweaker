<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Таргет .NET 10 Windows -->
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Version>0.9.3</Version>
		<AssemblyVersion>0.9.3</AssemblyVersion>
		<FileVersion>0.9.3</FileVersion>

		<!-- Иконка .EXE в Проводнике -->
		<ApplicationIcon>Hero.ico</ApplicationIcon>

		<!-- Платформа Windows и отключение платформенных предупреждений -->
		<TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
		<SupportedOSPlatform>windows</SupportedOSPlatform>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<!-- Включение иконки в ресурсы сборки для отображения в окне WPF -->
	<ItemGroup>
		<Resource Include="Hero.ico" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
	  <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
	  <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="ui-dist\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Include="Core\Tools\PresentMon\PresentMon-x64.exe" LogicalName="HeroTweaker.PresentMon-x64.exe" />
	  <EmbeddedResource Include="Core\Tools\PresentMon\LICENSE.txt" LogicalName="HeroTweaker.PresentMon.LICENSE.txt" />
	  <EmbeddedResource Include="Core\Tools\LibreHardwareMonitor\NOTICE.txt" LogicalName="HeroTweaker.LibreHardwareMonitor.NOTICE.txt" />
	</ItemGroup>

	<!-- Публикация файловой сборки: архив релиза распаковывается один раз, дальнейшие обновления применяются по кнопке. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<PublishDir>publish\</PublishDir>
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

</Project>
