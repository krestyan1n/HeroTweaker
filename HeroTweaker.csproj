<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Таргет .NET 10 Windows -->
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Version>0.8.7-beta</Version>
		<AssemblyVersion>0.8.7.0</AssemblyVersion>
		<FileVersion>0.8.7.0</FileVersion>

		<!-- Иконка .EXE в Проводнике -->
		<ApplicationIcon>Hero.ico</ApplicationIcon>

		<!-- Платформа Windows и отключение платформенных предупреждений -->
		<TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
		<SupportedOSPlatform>windows</SupportedOSPlatform>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<!-- Включение иконки в ресурсы сборки для отображения в окне WPF -->
	<ItemGroup>
		<Resource Include="Hero.ico" />
	</ItemGroup>

	<!-- Параметры публикации единого EXE-файла в папку publish -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<PublishDir>publish\</PublishDir>
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

</Project>