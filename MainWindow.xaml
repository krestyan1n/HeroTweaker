<Window x:Class="HeroTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HeroTweaker.Core.Helpers"
        xmlns:converters="clr-namespace:HeroTweaker.Converters"
        xmlns:controls="clr-namespace:HeroTweaker.Controls"
        Title="HeroTweaker v0.8.7.3 BETA" 
        Icon="pack://application:,,,/Hero.ico"
        Height="860" Width="1280"
        MinHeight="720" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="WindowBgBrush" Color="#080C14" />
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#060910" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#0D1322" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#162035" />
        <SolidColorBrush x:Key="BorderBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="CyanGlowBrush" Color="#0284C7" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

        <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2538BDF8" Offset="0.0" />
            <GradientStop Color="#0F1E293B" Offset="0.5" />
            <GradientStop Color="#200284C7" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Тонкий темный скроллбар -->
        <Style x:Key="DarkScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" CornerRadius="3" Background="#1E293B" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource CyanAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource CyanGlowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Выпадающий список ComboBox для адаптеров -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#0A101E"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Style>
                                    <Style TargetType="{x:Type ToggleButton}">
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                        <Border Width="30" HorizontalAlignment="Right" Background="Transparent">
                                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="#0C1220" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, ElementName=templateRoot}" MaxHeight="240" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.85"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки интерфейса -->
        <Style x:Key="DarkCardButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CyanActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource CyanAccentBrush}" />
            <Setter Property="Foreground" Value="#080C14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Хлебные крошки -->
        <Style x:Key="BreadcrumbButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#141F33"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2F4C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#294066"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostLinkButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,2,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyanToggleSwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="44" Height="22" CornerRadius="11" Background="#141C2E" BorderBrush="#243048" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush x:Name="ThumbBrush" Color="#64748B" />
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="ThumbBrush" Storyboard.TargetProperty="Color" To="#080C14" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="ThumbBrush" Storyboard.TargetProperty="Color" To="#64748B" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource CyanAccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Разделитель контекстного меню -->
        <Style x:Key="DarkMenuSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Rectangle Height="1" Fill="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль пунктов меню: без белой колонки иконок, со скруглением и подсветкой -->
        <Style x:Key="DarkMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Margin="2,1" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" 
                                              RecognizesAccessKey="True" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль ContextMenu: удаляет системный белый gutter и рисует тёмный контейнер с тенью -->
        <Style x:Key="DarkContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Background" Value="#0C1322"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.75"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Контекстное меню диска -->
        <ContextMenu x:Key="DiskItemContextMenu" Style="{StaticResource DarkContextMenuStyle}">
            <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                      Command="{Binding Path=DataContext.OpenItemInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                      CommandParameter="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Header>
                    <TextBlock Text="📁  Показать в Проводнике" Foreground="White" FontWeight="SemiBold"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                      Command="{Binding Path=DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                      CommandParameter="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Header>
                    <TextBlock Text="📋  Копировать полный путь" Foreground="#94A3B8"/>
                </MenuItem.Header>
            </MenuItem>
            <Separator Style="{StaticResource DarkMenuSeparatorStyle}"/>
            <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                      Command="{Binding Path=DataContext.DeleteDiskItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                      CommandParameter="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Header>
                    <TextBlock Text="🗑️  Переместить в Корзину" Foreground="#F87171" FontWeight="Bold"/>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ЛЕВЫЙ САЙДБАР -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,0,20">
                    <Border Width="48" Height="48" CornerRadius="12" Background="#0C1526" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="1.5" Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/Hero.ico" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HeroTweaker" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="v0.8.7.3 · BETA" FontSize="9.5" Foreground="{DynamicResource CyanAccentBrush}" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="МОДУЛИ СИСТЕМЫ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,6"/>

                        <Button Content="💻  Информация" Command="{Binding SelectCategoryCommand}" CommandParameter="Информация">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Информация">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Диск">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Диск">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="180">
                                <TextBlock Text="💾  Диск" FontSize="13" HorizontalAlignment="Left"/>
                                <Border Background="#1A38BDF8" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right">
                                    <TextBlock Text="Очистка" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Content="📦  Драйверы &amp; Runtimes" Command="{Binding SelectCategoryCommand}" CommandParameter="Драйверы">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Драйверы">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="📱  Приложения &amp; Toolbox" Command="{Binding SelectCategoryCommand}" CommandParameter="Приложения">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Приложения">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🛠️  Developer Doctor" Command="{Binding SelectCategoryCommand}" CommandParameter="Developer">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Developer">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🚀  Автозагрузка" Command="{Binding SelectCategoryCommand}" CommandParameter="Автозагрузка">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Автозагрузка">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="⚡  Сеть &amp; Пинг" Command="{Binding SelectCategoryCommand}" CommandParameter="Сеть &amp; Пинг">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Сеть &amp; Пинг">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="ТВИКИ ОС" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,14,0,6"/>

                        <Button Content="🔒  Приватность" Command="{Binding SelectCategoryCommand}" CommandParameter="Приватность">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Приватность">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="⚡  Производительность" Command="{Binding SelectCategoryCommand}" CommandParameter="Производительность">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Производительность">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="⚙️  Службы" Command="{Binding SelectCategoryCommand}" CommandParameter="Службы">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Службы">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🎨  Интерфейс" Command="{Binding SelectCategoryCommand}" CommandParameter="Интерфейс">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Интерфейс">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🔄  Обновления" Command="{Binding SelectCategoryCommand}" CommandParameter="Обновления">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Обновления">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- REAL-TIME ВИДЖЕТ -->
                <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,10,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="CPU LOAD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding RealTimeCpuUsage, StringFormat='{}{0}%'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Height="4" Value="{Binding RealTimeCpuUsage}" Maximum="100" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="RAM USAGE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding RealTimeRamUsage, StringFormat='{}{0}%'}" FontSize="10" FontWeight="Bold" Foreground="#F43F5E" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Height="4" Value="{Binding RealTimeRamUsage}" Maximum="100" Background="#141C2E" Foreground="#F43F5E" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- Настройки -->
                <Button Grid.Row="3" Command="{Binding SelectCategoryCommand}" CommandParameter="Настройки">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Настройки">
                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Width="180">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="⚙️" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Настройки твикера" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ОБЛАСТЬ КОНТЕНТА -->
        <Grid Grid.Column="1" Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ШАПКА -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding SelectedCategory}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CategorySubtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📋 История" Command="{Binding ToggleHistoryCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="🛡️ Бэкап ОС" Command="{Binding CreateRestorePointCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="🧹 Temp/RAM" Command="{Binding CleanTempAndRamCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="⚡ Explorer" Command="{Binding RestartExplorerCommand}" Style="{StaticResource CyanActionButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- СТЕК БАННЕРОВ -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <Border Background="#162B3D" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,8" Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LatestVersionTag, StringFormat='🚀 Доступна новая версия: {0}'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Нажмите кнопку справа для перехода на страницу релиза и скачивания свежей версии." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Скачать обновление" Command="{Binding OpenUpdateUrlCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="12,5" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="✕" Command="{Binding DismissUpdateCommand}" Style="{StaticResource DarkCardButtonStyle}" Padding="8,4"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Visibility="{Binding IsGlobalBusy, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Система выполняет запрошенную операцию..." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Height="5" IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressValue}" Maximum="100" VerticalAlignment="Center" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ВКЛАДКИ -->
            <Grid Grid.Row="2">
                <!-- 1. ИНФОРМАЦИЯ -->
                <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Состояние системы" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="82" Height="82" HorizontalAlignment="Left">
                                            <Ellipse Stroke="#182236" StrokeThickness="6"/>
                                            <Ellipse Stroke="{DynamicResource CyanAccentBrush}" StrokeThickness="6" StrokeDashArray="20 8"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SystemHealthScore}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="% OPTIMIZED" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding SystemHealthStatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <Button Content="✨ Применить рекомендуемые твики" Command="{Binding ApplyAllRecommendationsCommand}" Style="{StaticResource CyanActionButtonStyle}" HorizontalAlignment="Left" Padding="14,6"/>
                                        </StackPanel>
                                    </Grid>
                                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,14,0,0">
                                        <Border Background="#090E1A" CornerRadius="6" Padding="10,6" Margin="0,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ActiveTweaksCount}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="ТВИКОВ АКТИВНО" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#090E1A" CornerRadius="6" Padding="10,6" Margin="2,0,2,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisabledServicesCount}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="ОТКЛЮЧЕНО СЛУЖБ" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#090E1A" CornerRadius="6" Padding="10,6" Margin="4,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FreedSpaceFormatted}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource CyanAccentBrush}"/>
                                                <TextBlock Text="ОБНАРУЖЕНО TEMP" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SysInfo.TotalRamFormatted, FallbackValue='RAM: 32 ГБ', StringFormat='Установлено: {0}'}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Button Content="⚡ Очистить память в 1 клик" Command="{Binding CleanMemoryCommand}" Style="{StaticResource GhostLinkButtonStyle}" Margin="0,2,0,10"/>
                                    <Separator Background="{DynamicResource BorderBrush}" Height="1" Margin="0,0,0,8"/>
                                    <TextBlock Text="DISKTREE PREVIEW" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="• Users" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="51.7%" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Height="3.5" Value="51.7" Maximum="100" Background="#141C2E" Foreground="#8B5CF6" BorderThickness="0" Margin="0,0,0,6"/>
                                    <Button Content="Открыть анализатор ❯" Command="{Binding SelectCategoryCommand}" CommandParameter="Диск" Background="Transparent" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="ОПЕРАЦИОННАЯ СИСТЕМА" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SysInfo.OsName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SysInfo.OsBuild, StringFormat='Сборка: {0}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ПРОЦЕССОР (CPU)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SysInfo.CpuName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SysInfo.CpuThreads, StringFormat='Потоков исполнения: {0}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Быстрый доступ к ключевым твикам" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding DashboardTweaks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#141E30" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource CyanToggleSwitchStyle}" IsChecked="{Binding TargetState, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. ДИСК (ИНТЕРАКТИВНЫЙ АНАЛИЗ + ГЛУБОКАЯ ОЧИСТКА) -->
                <Grid Visibility="{Binding IsDiskVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Переключатель подвкладок -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,12">
                        <UniformGrid Columns="2">
                            <Button Content="📊 Интерактивный анализ (DiskTree)" Command="{Binding SelectDiskSubTabCommand}" CommandParameter="0" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,3,0"/>
                            <Button Content="🧹 Глубокая очистка диска" Command="{Binding SelectDiskSubTabCommand}" CommandParameter="1" Style="{StaticResource DarkCardButtonStyle}" Margin="3,0,0,0"/>
                        </UniformGrid>
                    </Border>

                    <!-- Subtab 0: DiskTree -->
                    <Grid Grid.Row="1" Visibility="{Binding IsDiskTreeSubTabVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Хлебные крошки -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="⬅ Назад" Command="{Binding GoUpDiskCommand}" Style="{StaticResource DarkCardButtonStyle}" Padding="10,4" Margin="0,0,6,0"/>
                                    <Button Content="🔄" Command="{Binding RefreshDiskCommand}" Style="{StaticResource DarkCardButtonStyle}" Padding="8,4" Margin="0,0,6,0"/>
                                    <Button Content="💾 Диски ▾" Click="DriveSelectButton_Click" Style="{StaticResource CyanActionButtonStyle}" Padding="10,4"/>
                                </StackPanel>

                                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10,0">
                                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource BreadcrumbButtonStyle}" Margin="2,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📁 " FontSize="10" VerticalAlignment="Center"/>
                                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <PriorityBinding>
                                                                        <Binding Path="Title"/>
                                                                        <Binding Path="Name"/>
                                                                        <Binding Path="FullPath"/>
                                                                    </PriorityBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock Text="❯" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center" Margin="3,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Grid.Column="2" Content="📁 Обзор..." Command="{Binding ChooseDiskFolderCommand}" Style="{StaticResource DarkCardButtonStyle}" Padding="12,4"/>
                            </Grid>
                        </Border>

                        <ProgressBar Grid.Row="0" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="{Binding IsDiskScanning, Converter={StaticResource BoolToVis}}" Background="Transparent" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Margin="10,0,10,0"/>

                        <!-- Контент: Санбёрст 450px + Список -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="450" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Левая часть: Sunburst диаграмма -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                                <controls:DiskDonutChart x:Name="SunburstChart"
                                                         ItemsSource="{Binding AllSunburstSlices}"
                                                         TotalSizeText="{Binding CurrentDiskTotalFormatted}"
                                                         FolderNameText="{Binding CurrentDiskFolderName}"
                                                         ItemClickCommand="{Binding DrillDownDiskCommand}"
                                                         HoveredItem="{Binding HoveredDiskItem, Mode=TwoWay}"
                                                         ItemContextMenu="{StaticResource DiskItemContextMenu}"/>
                            </Border>

                            <!-- Правая часть: Список папок -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <ScrollViewer x:Name="DiskListScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="Level1ItemsControl" ItemsSource="{Binding Level1ListItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="12,9" MouseEnter="DiskRow_MouseEnter" MouseLeave="DiskRow_MouseLeave" ContextMenuOpening="DiskRow_ContextMenuOpening" ContextMenu="{StaticResource DiskItemContextMenu}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📁 " FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.8"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                                        <Button Grid.Column="2" Content="Открыть" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.DrillDownDiskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DarkCardButtonStyle}" Padding="10,4" FontSize="11"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Оверлей загрузки -->
                            <Border Grid.ColumnSpan="2" Background="#C0080C14" CornerRadius="10" Visibility="{Binding IsDiskScanning, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1000">
                                <Border Background="#10192A" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True" Width="220" Height="4" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Margin="0,0,0,12"/>
                                        <TextBlock Text="Анализ дискового пространства..." FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentDiskPath, StringFormat='Сканирование: {0}'}" FontSize="11" Foreground="{DynamicResource CyanAccentBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Subtab 1: Cleanup (ГЛУБОКАЯ ОЧИСТКА ДИСКА) -->
                    <Grid Grid.Row="1" Visibility="{Binding IsDiskCleanupSubTabVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Шапка очистки с кнопкой (Row 0) -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Выбрано для освобождения: " FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding TotalCleanableFormatted}" FontSize="14" FontWeight="Black" Foreground="{DynamicResource CyanAccentBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Безопасная очистка системных кэшей, дампов и неиспользуемых временных файлов." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🧹 Очистить выбранное" Command="{Binding ExecuteCleanDiskCategoriesCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="18,8" FontSize="13"/>
                            </Grid>
                        </Border>

                        <!-- Список категорий (Row 1) -->
                        <ScrollViewer Grid.Row="1" x:Name="DiskCleanupScrollViewer" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CleanupCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="20" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                                <CheckBox Grid.Column="3" Style="{StaticResource CyanToggleSwitchStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 3. ДРАЙВЕРЫ & RUNTIMES -->
                <Grid Visibility="{Binding IsDriversVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                        <Button Content="🔍 Сканировать WU" Command="{Binding SearchDriverUpdatesCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,4,0"/>
                        <Button Content="📦 Экспорт (Бэкап)" Command="{Binding BackupDriversCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="2,0,2,0"/>
                        <Button Content="📥 Импорт (Откат)" Command="{Binding RestoreDriversCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="2,0,2,0"/>
                        <Button Content="⚙️ Visual C++ AIO" Command="{Binding InstallVCRuntimesCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="4,0,0,0"/>
                    </UniformGrid>

                    <Border Grid.Row="1" Background="#162B3D" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding HasDriverUpdates, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FoundDriversStatusText, FallbackValue='Обнаружены обновления драйверов'}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                <TextBlock Text="Нажмите кнопку для автоматической загрузки и установки пакетов через Windows Update." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="🚀 Установить драйверы" Command="{Binding InstallDriverUpdatesCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="16,6"/>
                        </Grid>
                    </Border>

                    <ProgressBar Grid.Row="2" Value="{Binding DriverProgress}" Maximum="100" Height="4" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Margin="0,0,0,10" Visibility="{Binding IsConsoleRunning, Converter={StaticResource BoolToVis}}"/>

                    <Border Grid.Row="3" Background="#060910" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer x:Name="ConsoleScroller" Margin="14">
                            <ItemsControl ItemsSource="{Binding ConsoleLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Consolas" FontSize="11.5" Margin="0,2">
                                            <Run Text="{Binding FormattedTime, Mode=OneWay}" Foreground="#475569"/><Run Text=" "/><Run Text="{Binding Prefix, Mode=OneWay}" Foreground="{Binding ColorHex, Mode=OneWay}" FontWeight="Bold"/><Run Text=" "/><Run Text="{Binding Message, Mode=OneWay}" Foreground="{Binding ColorHex, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 4. ПРИЛОЖЕНИЯ & TOOLBOX -->
                <Grid Visibility="{Binding IsAppsVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,12">
                        <UniformGrid Columns="3">
                            <Button Content="📦 Каталог ПО (Toolbox)" Command="{Binding SelectAppsSubTabCommand}" CommandParameter="0" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,3,0"/>
                            <Button Content="🗑️ Установленные программы" Command="{Binding SelectAppsSubTabCommand}" CommandParameter="1" Style="{StaticResource DarkCardButtonStyle}" Margin="2,0,2,0"/>
                            <Button Content="🔄 Восстановление UWP" Command="{Binding SelectAppsSubTabCommand}" CommandParameter="2" Style="{StaticResource DarkCardButtonStyle}" Margin="3,0,0,0"/>
                        </UniformGrid>
                    </Border>
                    <ScrollViewer x:Name="CatalogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCatalogSubTabVisible, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding CatalogApps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="{DynamicResource CardHoverBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="16" Opacity="0.5"/>
                                                    <Image Source="{Binding IconUrl}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="{DynamicResource CyanAccentBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Установить" Command="{Binding DataContext.InstallCatalogAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource CyanActionButtonStyle}" Padding="10,4" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Visibility="{Binding IsInstalledSubTabVisible, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer x:Name="InstalledScrollViewer" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredInstalledPrograms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayVersion}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="Удалить" Command="{Binding DataContext.UninstallProgramCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DarkCardButtonStyle}" Foreground="#F87171" Padding="10,4"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <ScrollViewer x:Name="RestoreScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsRestoreSubTabVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🛍️ Восстановление Microsoft Store" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Переустанавливает системный магазин Windows Store." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Восстановить Store" Command="{Binding RestoreStoreCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="14,6"/>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🔄 Полная перерегистрация всех UWP приложений" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Восстанавливает стандартный Калькулятор, Фотографии, Блокнот." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Восстановить все" Command="{Binding RestoreAllUwpCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="14,6"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 5. DEVELOPER DOCTOR -->
                <Grid Visibility="{Binding IsDeveloperVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Developer Doctor &amp; PATH" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Аудит окружения разработки: компиляторы, разрешение бинарников и чистка дубликатов PATH" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding DevScanButtonText}" Command="{Binding ScanDeveloperDoctorCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="14,6"/>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="DeveloperScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="СРЕДЫ РАЗРАБОТКИ, КОМПИЛЯТОРЫ И SDK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" Margin="2,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding DevComponents}" Margin="0,0,0,14">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IconGlyph}" FontSize="15" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="В НОРМЕ" FontSize="8.5" FontWeight="Bold" Foreground="#10B981"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource CyanAccentBrush}" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                                <TextBlock Grid.Row="2" Text="{Binding Details}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text=">_ Кто владеет командой? (CLI Inspector)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Определяет, какой именно бинарный файл вызывается первым в PATH при вводе команды в терминале, и находит конфликты между Anaconda, Python, Node и MSYS2." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0A101C" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                            <TextBox Text="{Binding InspectCommandInput, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="12"/>
                                        </Border>
                                        <Button Grid.Column="1" Content="Проверить вызов" Command="{Binding InspectCommandOwnerCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="14,5"/>
                                    </Grid>
                                    <Border Background="#090E1A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Visibility="{Binding HasInspectResult, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Первичный исполняемый файл:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding InspectResult.ResolvedExecutablePath}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                            <TextBlock Text="Ответ версии:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding InspectResult.VersionOutput}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Аудит системных и пользовательских переменных PATH" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding DevBrokenPathsCount, StringFormat='Обнаружено проблемных записей (битые каталоги/дубликаты): {0}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Content="🧹 Очистить проблемные пути" Command="{Binding CleanBrokenPathsCommand}" Style="{StaticResource DarkCardButtonStyle}" Foreground="#F87171" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PathEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#070A14" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#14FFFFFF" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding TypeText}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding StatusColorHex}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 6. АВТОЗАГРУЗКА -->
                <Grid Visibility="{Binding IsStartupVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Программы в автозапуске: "/><Run Text="{Binding StartupCount, Mode=OneWay}"/><Run Text=" (Тяжелых: "/><Run Text="{Binding HighImpactStartupCount, Mode=OneWay}" Foreground="#F87171" FontWeight="Bold"/><Run Text=")"/>
                                </TextBlock>
                                <TextBlock Text="Отключение тяжелых фоновых клиентов экономит циклы процессора и ускоряет загрузку рабочего стола Windows." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Пересканировать" Command="{Binding ScanStartupCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="14,5"/>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="StartupScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding StartupItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="12,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Command}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ImpactText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ImpactColorHex}"/>
                                            </Border>
                                            <CheckBox Grid.Column="2" Style="{StaticResource CyanToggleSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Command="{Binding DataContext.ToggleStartupItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 7. СЕТЬ & ПИНГ -->
                <ScrollViewer x:Name="NetworkScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsNetworkVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="🌐 Физический сетевой адаптер" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                    <Button Content="🔄 Обновить" Command="{Binding RefreshAdaptersCommand}" Style="{StaticResource DarkCardButtonStyle}" HorizontalAlignment="Right" Padding="10,4"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableAdapters}" SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}" Height="38" Margin="0,0,12,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                                    <TextBlock Text="🔌" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                                            <TextBlock Text="{Binding IpAddress, StringFormat='  ({0})'}" Foreground="{DynamicResource CyanAccentBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Border Grid.Column="1" Background="#14060B12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ТЕКУЩИЙ DNS АДАПТЕРА" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedAdapter.CurrentDns, FallbackValue='DHCP (Авто)'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🚨 Сетевой Реаниматор (Rescue Kit)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                    <Border Background="#26F87171" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="OFFLINE FIX" FontSize="9" FontWeight="Bold" Foreground="#F87171"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Восстановление интернета после установки Windows: рескан оборудования, инсталляция INF-драйверов и сброс сетевого стека." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <Button Content="🔍 Рескан шины PnP" Command="{Binding RescanPnpDevicesCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,4,0"/>
                                    <Button Content="📦 Установить INF из папки..." Command="{Binding InstallDriverFromFolderCommand}" Style="{StaticResource CyanActionButtonStyle}" Margin="2,0,2,0"/>
                                    <Button Content="🔄 Сброс стека (netcfg -d)" Command="{Binding HardResetNetworkStackCommand}" Style="{StaticResource DarkCardButtonStyle}" Foreground="#F87171" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,4,0,0">
                                    <Button Content="🔌 Установить Loopback адаптер" Command="{Binding InstallLoopbackAdapterCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,4,0"/>
                                    <Button Content="📱 Мастер USB-модема (RNDIS)" Command="{Binding ShowRndisHelpCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="4,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🎮 Ultra Low Latency Mode (Nagle Disabled)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Отключает задержку отправки TCP-пакетов (TCPNoDelay=1, TcpAckFrequency=1). Снижает сетевой инпут-лаг в играх." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource CyanToggleSwitchStyle}" IsChecked="{Binding IsNagleEnabled, Mode=OneWay}" Command="{Binding ToggleNagleCommand}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="⚡ DNS Benchmark &amp; Быстрое переключение" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Сброс на DHCP" Command="{Binding ResetDnsToDhcpCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,6,0"/>
                                        <Button Content="⚡ Замер пинга" Command="{Binding RunDnsBenchmarkCommand}" Style="{StaticResource CyanActionButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding DnsServers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#09FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="#14FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IconGlyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <Border Background="#2010B981" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" Visibility="{Binding IsFastest, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="⚡ САМЫЙ БЫСТРЫЙ" FontSize="8.5" FontWeight="Bold" Foreground="#10B981"/>
                                                            </Border>
                                                            <Border Background="#2038BDF8" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="АКТИВЕН" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PrimaryIp}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding SecondaryIp}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding PingText}" FontSize="13" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="{Binding PingColorHex}"/>
                                                        </TextBlock.Foreground></TextBlock>
                                                    <Button Grid.Column="4" Content="Выбрать" Command="{Binding DataContext.ApplyDnsServerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DarkCardButtonStyle}" Padding="10,4" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 8. ТВIКИ ОС -->
                <ScrollViewer x:Name="TweaksScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsTweaksVisible, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RiskText}" FontSize="9" FontWeight="Bold" Foreground="{Binding RiskColorHex}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource CyanToggleSwitchStyle}" IsChecked="{Binding TargetState, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                        <Expander Grid.Row="1" Header="ℹ️ Подробнее (Why &amp; Under the Hood)" Foreground="{DynamicResource CyanAccentBrush}" FontSize="11" Margin="0,8,0,0">
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Text="{Binding UserWhy}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <Border Background="#14000000" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                                    <TextBlock Text="{Binding TechDetails}" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource CyanAccentBrush}" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Expander>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 9. НАСТРОЙКИ -->
                <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Цветовая палитра оформления" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Мягкие темные темы. Мгновенная смена стилевых акцентов без перезапуска приложения." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding AvailableThemes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,6,0" Padding="10,12">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <Border Background="{Binding AccentBrush}" Width="16" Height="16" CornerRadius="8" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Кэш анализатора DiskTree" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DiskCacheFormatted, StringFormat='Снимки структуры папок хранятся в %AppData% для мгновенного повторного открытия: {0}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Очистить кэш" Command="{Binding ClearDiskCacheCommand}" Style="{StaticResource DarkCardButtonStyle}" Foreground="#F87171" Padding="12,5"/>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="О приложении HeroTweaker" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Версия ядра: v0.8.7.3 Beta • Hero Engineering" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 3. НИЖНЯЯ ПАНЕЛЬ ПРИМЕНЕНИЯ -->
            <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="0,1,0,0" Padding="16,8" Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PendingCount, StringFormat='Ожидает сохранения: {0} твиков выбрано для оптимизации'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Сбросить" Command="{Binding DiscardAllPendingCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Применить изменения" Command="{Binding ApplyAllPendingCommand}" Style="{StaticResource CyanActionButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ЖУРНАЛ АУДИТА -->
        <Border Grid.ColumnSpan="2" Background="#D004070F" Panel.ZIndex="5000" Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#0C1220" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Width="680" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📋 Журнал транзакций &amp; Rollback" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Снимки системы для гарантированного отката любого изменения." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Content="✕" Command="{Binding ToggleHistoryCommand}" Style="{StaticResource DarkCardButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,4"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AuditHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#070A14" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TweakName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="↩️ Откатить" Command="{Binding DataContext.RollbackTransactionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Style="{StaticResource DarkCardButtonStyle}" Foreground="#F87171" Padding="8,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- СПЛЭШ-СКРИН ЗАГРУЗКИ -->
        <Grid Grid.ColumnSpan="2" Background="#FA060910" Panel.ZIndex="9999" Visibility="{Binding IsAppLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
                <Border Width="88" Height="88" CornerRadius="18" Background="#0C1526" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,20,0">
                    <Image Source="pack://application:,,,/Hero.ico" Width="60" Height="60" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="Hero" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Tweaker" FontSize="26" FontWeight="Light" Foreground="{DynamicResource CyanAccentBrush}" />
                </StackPanel>
                <TextBlock Text="Hero Engineering • v0.8.7.3 BETA" FontSize="10.5" Foreground="{DynamicResource CyanGlowBrush}" HorizontalAlignment="Center" Margin="0,0,0,20" FontWeight="SemiBold"/>
                <ProgressBar Value="{Binding SplashProgress}" Maximum="100" Height="3" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding SplashStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>