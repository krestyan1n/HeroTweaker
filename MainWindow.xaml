<Window x:Class="HeroTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HeroTweaker.Core.Helpers"
        xmlns:converters="clr-namespace:HeroTweaker.Converters"
        xmlns:controls="clr-namespace:HeroTweaker.Controls"
        Title="HeroTweaker — Windows Optimizer" 
        Icon="pack://application:,,,/Hero.ico"
        Height="840" Width="1200"
        MinHeight="720" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Основная палитра Slate Cyan / Deep Navy -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#0B0F19" />
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#070A10" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#111827" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="CyanGlowBrush" Color="#0284C7" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

        <SolidColorBrush x:Key="SurfaceBgBrush" Color="#111827" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentGlowBrush" Color="#0284C7" />

        <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3038BDF8" Offset="0.0" />
            <GradientStop Color="#151E293B" Offset="0.5" />
            <GradientStop Color="#250284C7" Offset="1.0" />
        </LinearGradientBrush>

        <!-- КАСТОМНЫЙ SCROLLBAR -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" CornerRadius="3" Background="#1E293B" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource CyanAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource CyanGlowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="#070A12">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="#070A12">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Пункты контекстного меню -->
        <Style x:Key="DarkMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#101726"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="DiskItemContextMenu" Style="{StaticResource DarkContextMenuStyle}">
            <ContextMenu.Resources>
                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource DarkMenuItemStyle}"/>
            </ContextMenu.Resources>
            <MenuItem Header="📁  Показать в Проводнике" Command="{Binding Path=DataContext.OpenItemInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" FontWeight="SemiBold"/>
            <MenuItem Header="📋  Копировать полный путь" Command="{Binding Path=DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Separator Background="{DynamicResource BorderBrush}" Height="1" Margin="4,3"/>
            <MenuItem Header="🗑️  Переместить в Корзину" Command="{Binding Path=DataContext.DeleteDiskItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="#F87171" FontWeight="Bold"/>
        </ContextMenu>

        <Style x:Key="CyanToggleSwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="44" Height="22" CornerRadius="11" Background="#141C2E" BorderBrush="#243048" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush x:Name="ThumbBrush" Color="#64748B" />
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="ThumbBrush" Storyboard.TargetProperty="Color" To="#0B0F19" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="ThumbBrush" Storyboard.TargetProperty="Color" To="#64748B" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource CyanAccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyanActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CyanAccentBrush}" />
            <Setter Property="Foreground" Value="#0B0F19" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ЛЕВЫЙ САЙДБАР С АКТИВНОЙ ПОДСВЕТКОЙ И ИКОНКОЙ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,0,22">
                    <Border Width="52" Height="52" CornerRadius="12" Background="#0C1526" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="1.5" Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/Hero.ico" 
                               Width="40" Height="40" 
                               RenderOptions.BitmapScalingMode="HighQuality" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HeroTweaker" FontSize="17" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="v0.8.5 · PRO" FontSize="10" Foreground="{DynamicResource CyanAccentBrush}" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="МОДУЛИ СИСТЕМЫ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,6"/>

                        <Button Content="💻  Информация" Command="{Binding SelectCategoryCommand}" CommandParameter="Информация">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Информация">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Диск">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Диск">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="180">
                                <TextBlock Text="💾  Диск" FontSize="13" HorizontalAlignment="Left"/>
                                <Border Background="#1A38BDF8" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right">
                                    <TextBlock Text="Очистка" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Content="📦  Драйверы &amp; Runtimes" Command="{Binding SelectCategoryCommand}" CommandParameter="Драйверы">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Драйверы">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="📱  Приложения &amp; Toolbox" Command="{Binding SelectCategoryCommand}" CommandParameter="Приложения">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Приложения">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🛠️  Developer Doctor" Command="{Binding SelectCategoryCommand}" CommandParameter="Developer">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Developer">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🚀  Автозагрузка" Command="{Binding SelectCategoryCommand}" CommandParameter="Автозагрузка">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Автозагрузка">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="ТВИКИ ОС" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,16,0,6"/>

                        <Button Content="🔒  Приватность" Command="{Binding SelectCategoryCommand}" CommandParameter="Приватность">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Приватность">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="⚡  Производительность" Command="{Binding SelectCategoryCommand}" CommandParameter="Производительность">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Производительность">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="⚙️  Службы" Command="{Binding SelectCategoryCommand}" CommandParameter="Службы">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Службы">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🎨  Интерфейс" Command="{Binding SelectCategoryCommand}" CommandParameter="Интерфейс">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Интерфейс">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🔄  Обновления" Command="{Binding SelectCategoryCommand}" CommandParameter="Обновления">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Обновления">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- REAL-TIME ВИДЖЕТ -->
                <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,10,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource CyanAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="REAL-TIME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RealTimeCpuUsage, StringFormat='{}{0}%'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Height="4" Value="{Binding RealTimeCpuUsage}" Maximum="100" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="RAM" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RealTimeRamUsage, StringFormat='{}{0}%'}" FontSize="10" FontWeight="Bold" Foreground="#F43F5E" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Height="4" Value="{Binding RealTimeRamUsage}" Maximum="100" Background="#141C2E" Foreground="#F43F5E" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- Настройки -->
                <Button Grid.Row="3" Command="{Binding SelectCategoryCommand}" CommandParameter="Настройки">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Настройки">
                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Width="180">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="⚙️" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Настройки твикера" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ОБЛАСТЬ КОНТЕНТА -->
        <Grid Grid.Column="1" Margin="26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ШАПКА -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding SelectedCategory}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CategorySubtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📋 История" Command="{Binding ToggleHistoryCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,6,0" Padding="12,6"/>
                    <Button Content="🛡️ Бэкап ОС" Command="{Binding CreateRestorePointCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,6,0" Padding="12,6"/>
                    <Button Content="🧹 Temp" Command="{Binding CleanTempCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,6,0" Padding="12,6"/>
                    <Button Content="⚡ Explorer" Command="{Binding RestartExplorerCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="14,6"/>
                </StackPanel>
            </Grid>

            <!-- ГЛОБАЛЬНЫЙ БАННЕР ОПЕРАЦИЙ -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" Visibility="{Binding IsGlobalBusy, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Операционная система выполняет оптимизацию..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Height="6" IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressValue}" Maximum="100" VerticalAlignment="Center" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- ===================== ВКЛАДКИ ===================== -->
            <Grid Grid.Row="2">
                <!-- 1. ИНФОРМАЦИЯ (ДАШБОРД) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Состояние системы" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="96" Height="96" HorizontalAlignment="Left">
                                            <Ellipse Stroke="#182236" StrokeThickness="7"/>
                                            <Ellipse Stroke="{DynamicResource CyanAccentBrush}" StrokeThickness="7" StrokeDashArray="20 8" RenderTransformOrigin="0.5, 0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform x:Name="HealthWheelRotate" Angle="0"/>
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="HealthWheelRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SystemHealthScore}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="% OPTIMIZED" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding SystemHealthStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                            <Button Content="✨ Применить рекомендуемые твики" Command="{Binding ApplyAllRecommendationsCommand}" Style="{StaticResource CyanActionButtonStyle}" HorizontalAlignment="Left" Padding="16,8"/>
                                        </StackPanel>
                                    </Grid>

                                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,18,0,0">
                                        <Border Background="#090E1A" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ActiveTweaksCount}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="ТВИКОВ АКТИВНО" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#090E1A" CornerRadius="8" Padding="12,8" Margin="3,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisabledServicesCount}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="ОТКЛЮЧЕНО СЛУЖБ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#090E1A" CornerRadius="8" Padding="12,8" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FreedSpaceFormatted}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource CyanAccentBrush}"/>
                                                <TextBlock Text="ОБНАРУЖЕНО TEMP" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="56" Height="56">
                                            <Ellipse Stroke="#182236" StrokeThickness="5"/>
                                            <Ellipse Stroke="{DynamicResource CyanAccentBrush}" StrokeThickness="5" StrokeDashArray="14 8"/>
                                            <TextBlock Text="49%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding SysInfo.TotalRamFormatted, FallbackValue='32 ГБ', StringFormat='RAM: {0}'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Память оптимизирована" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                            <Button Content="⚡ Очистить память" Command="{Binding CleanMemoryCommand}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource CyanAccentBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Left" Padding="0,3,0,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Separator Background="{DynamicResource BorderBrush}" Height="1" Margin="0,0,0,12"/>
                                    <TextBlock Text="DISKTREE PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="• Users" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ProgressBar Grid.Column="1" Height="4" Value="51.7" Maximum="100" Background="#141C2E" Foreground="#8B5CF6" BorderThickness="0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="51.7%" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="• Program Files" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ProgressBar Grid.Column="1" Height="4" Value="36.8" Maximum="100" Background="#141C2E" Foreground="#EC4899" BorderThickness="0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="36.8%" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Button Content="Открыть анализатор ❯" Command="{Binding SelectCategoryCommand}" CommandParameter="Диск" Background="Transparent" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left" Cursor="Hand" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#0C1526" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="💻" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ОПЕРАЦИОННАЯ СИСТЕМА" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SysInfo.OsName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding SysInfo.OsBuild, StringFormat='Сборка: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#0C1526" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ПРОЦЕССОР (CPU)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SysInfo.CpuName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SysInfo.CpuThreads, StringFormat='Потоков исполнения: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️ Системные твики" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="• быстрый доступ" FontSize="11" Foreground="{DynamicResource CyanAccentBrush}" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="мгновенный эффект" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding DashboardTweaks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#141E30" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource CyanToggleSwitchStyle}" IsChecked="{Binding TargetState, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. ДИСК (DISKTREE + DEEP CLEANUP С ПОДВКЛАДКАМИ) -->
                <Grid Visibility="{Binding IsDiskVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,14">
                        <UniformGrid Columns="2">
                            <Button Content="📊 Интерактивный анализ (DiskTree)" Command="{Binding SelectDiskSubTabCommand}" CommandParameter="0" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,4,0"/>
                            <Button Content="🧹 Глубокая очистка диска" Command="{Binding SelectDiskSubTabCommand}" CommandParameter="1" Style="{StaticResource DarkCardButtonStyle}" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </Border>

                    <!-- Подвкладка 0: Анализатор DiskTree -->
                    <Grid Grid.Row="1" Visibility="{Binding IsDiskTreeSubTabVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="⬅ Назад" Command="{Binding GoUpDiskCommand}" Style="{StaticResource DarkCardButtonStyle}" Padding="10,5" Margin="0,0,6,0"/>
                                    <Button Content="🔄" Command="{Binding RefreshDiskCommand}" Style="{StaticResource DarkCardButtonStyle}" Padding="8,5" Margin="0,0,8,0"/>

                                    <Button Content="💾 Диски ▾" Click="DriveSelectButton_Click" Style="{StaticResource CyanActionButtonStyle}" Padding="10,5">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource DarkContextMenuStyle}" ItemsSource="{Binding AvailableDrives}">
                                                <ContextMenu.ItemContainerStyle>
                                                    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource DarkMenuItemStyle}">
                                                        <Setter Property="Command" Value="{Binding Path=DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <Setter Property="CommandParameter" Value="{Binding RootPath}"/>
                                                        <Setter Property="Header" Value="{Binding FormattedDescription}"/>
                                                    </Style>
                                                </ContextMenu.ItemContainerStyle>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>

                                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10,0">
                                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding Title}" Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="{DynamicResource CardHoverBrush}" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,4" Margin="2,0"/>
                                                    <TextBlock Text="❯" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center" Margin="2,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Grid.Column="2" Content="📁 Обзор..." Command="{Binding ChooseDiskFolderCommand}" Style="{StaticResource DarkCardButtonStyle}" Padding="12,5"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="430" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <Grid>
                                        <Ellipse Width="390" Height="390" Stroke="#0A1828" StrokeThickness="1" StrokeDashArray="4 8" RenderTransformOrigin="0.5, 0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="OrbitRotate" Angle="0"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="OrbitRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:1:10"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <controls:DiskDonutChart ItemsSource="{Binding AllSunburstSlices}" TotalSizeText="{Binding CurrentDiskTotalFormatted}" FolderNameText="{Binding CurrentDiskFolderName}" ItemClickCommand="{Binding DrillDownDiskCommand}" HoveredItem="{Binding HoveredDiskItem, Mode=TwoWay}" ItemContextMenu="{StaticResource DiskItemContextMenu}"/>
                                    </Grid>
                                </Border>

                                <Border Background="#F5060912" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Visibility="{Binding IsDiskScanning, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="140" Height="140" Margin="0,0,0,18">
                                            <Ellipse Width="130" Height="130" Stroke="{DynamicResource CyanAccentBrush}" StrokeThickness="2.5" StrokeDashArray="12 8" RenderTransformOrigin="0.5, 0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform x:Name="RadarOuterRotate" Angle="0"/>
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="RadarOuterRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3.5"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <Ellipse Width="95" Height="95" Stroke="#EC4899" StrokeThickness="2" StrokeDashArray="6 10" RenderTransformOrigin="0.5, 0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform x:Name="RadarInnerRotate" Angle="360"/>
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="RadarInnerRotate" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:4.8"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <TextBlock Text="⚡" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ProgressBar IsIndeterminate="True" Width="180" Height="5" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Margin="0,0,0,10"/>
                                        <TextBlock Text="ЧТЕНИЕ СЕКТОРОВ И КЭША DISKTREE..." Foreground="{DynamicResource CyanAccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Level1ListItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0E1424" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,6,6" Padding="10,8" MouseEnter="DiskRow_MouseEnter" MouseLeave="DiskRow_MouseLeave" ContextMenuOpening="DiskRow_ContextMenuOpening" ContextMenu="{StaticResource DiskItemContextMenu}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding ColorHex, FallbackValue='#38BDF8'}"/>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <ProgressBar Height="3" Value="{Binding Percentage}" Maximum="100" Background="#141C2E" BorderThickness="0" Margin="0,4,16,0">
                                                                <ProgressBar.Foreground>
                                                                    <SolidColorBrush Color="{Binding ColorHex, FallbackValue='#38BDF8'}"/>
                                                                </ProgressBar.Foreground>
                                                            </ProgressBar>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding FormattedSize}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding Percentage, StringFormat={}{0}%}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="3" Content="Открыть" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.DrillDownDiskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DarkCardButtonStyle}" Padding="8,4" FontSize="11"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Подвкладка 1: Глубокая очистка диска -->
                    <Grid Grid.Row="1" Visibility="{Binding IsDiskCleanupSubTabVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Выбрано для освобождения: " FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding TotalCleanableFormatted}" FontSize="14" FontWeight="Black" Foreground="{DynamicResource CyanAccentBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="Безопасная очистка системных кэшей, шейдеров и временных файлов." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🔍 Сканировать заново" Command="{Binding ScanCleanupCategoriesCommand}" Style="{StaticResource DarkCardButtonStyle}" Padding="14,6" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="🧹 Очистить выбранное" Command="{Binding ExecuteCleanDiskCategoriesCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="16,6"/>
                                </Grid>
                                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Visibility="{Binding IsScanningCleanable, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CleanupCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,8,8" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="22" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding FormattedSize}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding FilesCount, StringFormat='Файлов: {0}'}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="3" Style="{StaticResource CyanToggleSwitchStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 3. ДРАЙВЕРЫ & RUNTIMES -->
                <Grid Visibility="{Binding IsDriversVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                        <Button Content="🔍 Сканировать WU" Command="{Binding SearchDriverUpdatesCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="📦 Экспорт (Бэкап)" Command="{Binding BackupDriversCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="3,0,3,0"/>
                        <Button Content="📥 Импорт (Откат)" Command="{Binding RestoreDriversCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="3,0,3,0"/>
                        <Button Content="⚙️ Visual C++" Command="{Binding InstallVCRuntimesCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="6,0,0,0"/>
                    </UniformGrid>
                    <ProgressBar Grid.Row="1" Value="{Binding DriverProgress}" Maximum="100" Height="4" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Margin="0,0,0,12" Visibility="{Binding IsConsoleRunning, Converter={StaticResource BoolToVis}}"/>
                    <Border Grid.Row="2" Background="#060910" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <ScrollViewer x:Name="ConsoleScroller" Margin="14">
                            <ItemsControl ItemsSource="{Binding ConsoleLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,2">
                                            <Run Text="{Binding FormattedTime, Mode=OneWay}" Foreground="#475569"/>
                                            <Run Text=" "/><Run Text="{Binding Prefix, Mode=OneWay}" Foreground="{Binding ColorHex, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text=" "/><Run Text="{Binding Message, Mode=OneWay}" Foreground="{Binding ColorHex, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 4. ПРИЛОЖЕНИЯ & TOOLBOX С ОФИЦИАЛЬНЫМИ ИКОНКАМИ -->
                <Grid Visibility="{Binding IsAppsVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,14">
                        <UniformGrid Columns="3">
                            <Button Content="📦 Каталог ПО (Toolbox)" Command="{Binding SelectAppsSubTabCommand}" CommandParameter="0" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,4,0"/>
                            <Button Content="🗑️ Установленные программы" Command="{Binding SelectAppsSubTabCommand}" CommandParameter="1" Style="{StaticResource DarkCardButtonStyle}" Margin="2,0,2,0"/>
                            <Button Content="🔄 Восстановление UWP" Command="{Binding SelectAppsSubTabCommand}" CommandParameter="2" Style="{StaticResource DarkCardButtonStyle}" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </Border>

                    <!-- Подвкладка 0: Каталог софта с официальными логотипами -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCatalogSubTabVisible, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding CatalogApps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Бейдж с официальной иконкой и плавным фоллбэком -->
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource CardHoverBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                                    <Image Source="{Binding IconUrl}" Width="28" Height="28"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border Background="#2038BDF8" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Установить" Command="{Binding DataContext.InstallCatalogAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource CyanActionButtonStyle}" Padding="12,6" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Visibility="{Binding IsInstalledSubTabVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding AppsSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="13" VerticalContentAlignment="Center" Margin="6,0"/>
                                <Button Grid.Column="1" Content="🔄 Обновить список" Command="{Binding RefreshInstalledProgramsCommand}" Style="{StaticResource DarkCardButtonStyle}" Padding="12,4"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="#0C111E" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredInstalledPrograms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#090E1A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,6,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayVersion}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding EstimatedSize}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Content="🗑️ Удалить" Command="{Binding DataContext.UninstallProgramCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DarkCardButtonStyle}" Foreground="#F87171" Padding="10,4" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsRestoreSubTabVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,10,0">
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🛍️ Восстановление Microsoft Store" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Переустанавливает и регистрирует системный магазин Windows Store." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Восстановить Store" Command="{Binding RestoreStoreCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="14,8"/>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🔄 Полная перерегистрация всех стандартных UWP-приложений" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Восстанавливает Калькулятор, Блокнот, Фотографии и системные пакеты." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Восстановить все" Command="{Binding RestoreAllUwpCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="14,8"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 5. DEVELOPER DOCTOR & PATH DOCTOR -->
                <Grid Visibility="{Binding IsDeveloperVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Диагностика окружения разработки и аудит PATH" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Поиск установленных SDK, компиляторов, битых путей и конфликтов в переменных окружения." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding DevScanButtonText}" Command="{Binding ScanDeveloperDoctorCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="14,6"/>
                            </Grid>

                            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Visibility="{Binding IsDevScanning, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="📦 СРЕДЫ РАЗРАБОТКИ И SDK" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" Margin="2,0,0,10"/>

                            <ItemsControl ItemsSource="{Binding DevComponents}" Margin="0,0,0,18">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding IconGlyph}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding StatusColorHex}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Version}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="2" Text="{Binding Details}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="🔍 КТО ВЛАДЕЕТ КОМАНДОЙ? (CLI INSPECTOR)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Проверяет, какой именно бинарник вызывается системой первым, и находит конфликтующие дубликаты." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#070A14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                                            <TextBox Text="{Binding InspectCommandInput, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="1" Content="Проверить вызов" Command="{Binding InspectCommandOwnerCommand}" Style="{StaticResource DarkCardButtonStyle}" Padding="16,6"/>
                                    </Grid>

                                    <Border Background="#090E1A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="{Binding HasInspectResult, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="ПЕРВИЧНЫЙ ИСПОЛНЯЕМЫЙ ФАЙЛ:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding InspectResult.ResolvedExecutablePath}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" Margin="0,3,0,6"/>

                                            <TextBlock Text="ОТВЕТ ВЕРСИИ:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding InspectResult.VersionOutput}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="🛣️ АУДИТ ПЕРЕМЕННЫХ PATH" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                            <TextBlock Text="{Binding DevBrokenPathsCount, StringFormat='Обнаружено проблемных записей (битые/дубликаты): {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🧹 Очистить проблемные пути" Command="{Binding CleanBrokenPathsCommand}" Style="{StaticResource DarkCardButtonStyle}" Foreground="#F87171" Padding="12,6"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding PathEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#090E1A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TypeText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding StatusColorHex}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 6. АВТОЗАГРУЗКА (STARTUP DOCTOR) -->
                <Grid Visibility="{Binding IsStartupVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Программ в автозапуске: " FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding StartupCount}" FontSize="14" FontWeight="Black" Foreground="{DynamicResource CyanAccentBrush}"/>
                                        <TextBlock Text="{Binding HighImpactStartupCount, StringFormat='  (Тяжелых: {0})'}" FontSize="13" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Отключение фоновых программ ускоряет старт ПК и разгружает оперативную память." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🔄 Пересканировать" Command="{Binding ScanStartupCommand}" Style="{StaticResource CyanActionButtonStyle}" Padding="16,6"/>
                            </Grid>
                            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Visibility="{Binding IsStartupScanning, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding StartupItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,8,8" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Command}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="#10FFFFFF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Location}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>

                                            <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding ImpactText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ImpactColorHex}"/>
                                            </Border>

                                            <CheckBox Grid.Column="3" Style="{StaticResource CyanToggleSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Command="{Binding DataContext.ToggleStartupItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 7. ТВIКИ ОС -->
                <Grid Visibility="{Binding IsTweaksVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,8,10" Padding="16,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RiskText}" FontSize="10" FontWeight="Bold" Foreground="{Binding RiskColorHex}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource CyanToggleSwitchStyle}" IsChecked="{Binding TargetState, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            </Grid>

                                            <ToggleButton Content="ℹ️ Подробнее (Why?)" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Background="Transparent" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,6,0,0" Cursor="Hand">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Background="#0A0E1A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Metadata.WhatItDoes, StringFormat='Что делает: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding RebootText, StringFormat='Эффект: {0}'}" FontSize="11" Foreground="{DynamicResource CyanGlowBrush}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 8. НАСТРОЙКИ ТВIКЕРА -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🎨 ЦВЕТОВАЯ ТЕМА" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Мягкие дизайнерские палитры без едких кислотных оттенков. Применяются мгновенно." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                                <ItemsControl ItemsSource="{Binding AvailableThemes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,8,8" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5" Background="{Binding AccentBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="💾 КЭШ АНАЛИЗАТОРА DISKTREE" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                    <TextBlock Text="Снимки папок сохраняются в AppData для мгновенного повторного открытия." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding DiskCacheFormatted, StringFormat='Занято кэшем на диске: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🧹 Очистить кэш" Command="{Binding ClearDiskCacheCommand}" Style="{StaticResource DarkCardButtonStyle}" Foreground="#F87171" Padding="14,8" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="ℹ️ О ПРИЛОЖЕНИИ" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Версия:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="v0.8.5 · PRO" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Разработчик:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Hero Engineering" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Профиль:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Default" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 4. НИЖНЯЯ ПАНЕЛЬ ПРИМЕНЕНИЯ С ПРОГРЕСС-БАРОМ -->
            <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,12,0,0" Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Есть ожидающие изменения" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Нажмите кнопку для сохранения в системе" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Сбросить" Command="{Binding DiscardAllPendingCommand}" Style="{StaticResource DarkCardButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="🚀 Применить" Command="{Binding ApplyAllPendingCommand}" Style="{StaticResource CyanActionButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- МОДАЛЬНАЯ ШТОРКА: ЖУРНАЛ АУДИТА & UNDO -->
        <Border Grid.ColumnSpan="2" Background="#D004070F" Panel.ZIndex="5000" Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#0C1220" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Width="680" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📋 Журнал транзакций &amp; Rollback" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Все применённые изменения со снимками системы для гарантированного отката." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Content="✕" Command="{Binding ToggleHistoryCommand}" Style="{StaticResource DarkCardButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,4"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AuditHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#070A14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TweakName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{} • {0:HH:mm:ss dd.MM}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                                <TextBlock Text="Снимок реестра/службы сохранён" FontSize="10" Foreground="#10B981" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="↩️ Откатить" Command="{Binding DataContext.RollbackTransactionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Style="{StaticResource DarkCardButtonStyle}" Foreground="#F87171" FontWeight="Bold" Padding="10,5" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- СПЛЭШ-СКРИН С ИКОНКОЙ ПРИЛОЖЕНИЯ -->
        <Grid Grid.ColumnSpan="2" Background="#FA060910" Panel.ZIndex="9999" Visibility="{Binding IsAppLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <Border Width="104" Height="104" CornerRadius="22" Background="#0C1526" BorderBrush="{DynamicResource CyanAccentBrush}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Image Source="pack://application:,,,/Hero.ico" 
                           Width="72" Height="72" 
                           RenderOptions.BitmapScalingMode="HighQuality" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="Hero" FontSize="28" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Tweaker" FontSize="28" FontWeight="Light" Foreground="{DynamicResource CyanAccentBrush}" />
                </StackPanel>
                <TextBlock Text="Hero Engineering • v0.8.5" FontSize="11" Foreground="{DynamicResource CyanGlowBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" FontWeight="SemiBold"/>
                <ProgressBar Value="{Binding SplashProgress}" Maximum="100" Height="4" Background="#141C2E" Foreground="{DynamicResource CyanAccentBrush}" BorderThickness="0" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding SplashStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>