<Window x:Class="HeroTweaker.WebShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HeroTweaker"
        Icon="pack://application:,,,/Hero.ico"
        Width="1480" Height="900" MinWidth="1030" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#090D10" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="7" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <wv2:WebView2 x:Name="AppWebView" Visibility="Collapsed" DefaultBackgroundColor="#090D10" />
        <Border x:Name="BootstrapPanel" Background="#090D10" Padding="36">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                <TextBlock Text="HERO / SYSTEM WORKBENCH" FontFamily="Cascadia Mono" FontSize="9" Foreground="#72D7C2" Margin="0,0,0,11" />
                <TextBlock Text="Подготовка интерфейса" FontSize="23" FontWeight="SemiBold" Foreground="#E7EDF2" Margin="0,0,0,9" />
                <TextBlock x:Name="BootstrapStatus" Text="Проверка Microsoft Edge WebView2 Runtime…" Foreground="#9BAAB2" FontSize="12" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,20,0,0" Foreground="#72D7C2" Background="#1A292D" BorderThickness="0" />
            </StackPanel>
        </Border>
        <Border x:Name="WebViewFailurePanel" Visibility="Collapsed" Background="#0B1013" Padding="40">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                <TextBlock Text="Не удалось запустить интерфейс HeroTweaker" FontSize="22" FontWeight="SemiBold" Foreground="#E7EDF2" Margin="0,0,0,12" />
                <TextBlock x:Name="WebViewFailureMessage" TextWrapping="Wrap" Foreground="#9BAAB2" FontSize="13" LineHeight="21" />
                <Button Content="Повторить запуск" Click="RetryWebView_Click" Margin="0,22,0,0" Padding="18,9" HorizontalAlignment="Left" />
                <Button Content="Открыть загрузку WebView2 Runtime" Click="DownloadWebView2_Click" Margin="0,8,0,0" Padding="18,9" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
